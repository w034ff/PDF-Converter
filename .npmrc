engine-strict=true
; Supply-chain policy (design §9). Versions published within the last 7 days are
; not installed, matching the Dependabot cooldown; `npm ci` still installs
; exactly what package-lock.json lists.
min-release-age=7
; Dependency install scripts would run arbitrary code. If a dependency ever needs
; one, run it explicitly: npm rebuild <name> --ignore-scripts=false
ignore-scripts=true
