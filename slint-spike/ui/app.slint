import { T } from "tokens.slint";
import { OrganizeView, CellData, SourceChip } from "organize.slint";
import "../fonts/IBMPlexSansJP-Regular.ttf";
import "../fonts/IBMPlexSansJP-Medium.ttf";
import "../fonts/IBMPlexSansJP-SemiBold.ttf";

export { T, CellData, SourceChip }

component TabButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: label.preferred-width + 28px;
    accessible-role: tab;
    accessible-label: text;
    accessible-item-selectable: true;
    accessible-item-selected: active;
    accessible-action-default => { clicked(); }
    label := Text {
        accessible-role: none;
        text: root.text;
        color: active ? T.text-primary : T.text-secondary;
        font-size: T.font-lg;
        font-weight: active ? 600 : 400;
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: active ? T.accent : transparent;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component LangButton inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked;
    width: l.preferred-width + 16px;
    height: 26px;
    border-radius: T.radius-sm;
    background: active ? T.bg-hover : transparent;
    accessible-role: button;
    accessible-label: text;
    accessible-checkable: true;
    accessible-checked: active;
    accessible-action-default => { clicked(); }
    l := Text {
        accessible-role: none;
        text: root.text;
        color: active ? T.text-primary : T.text-secondary;
        font-size: T.font-sm;
    }
    TouchArea {
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "PDF Converter (Slint spike)";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 480px;
    min-height: 400px;
    default-font-family: "IBM Plex Sans JP";
    background: T.bg-app;

    in-out property <int> active-tab: 3;
    in-out property <string> language: "ja";

    // Forwarded to OrganizeView.
    in property <[SourceChip]> chips <=> organize.chips;
    in property <[CellData]> cells <=> organize.cells;
    in property <int> page-count <=> organize.page-count;
    in property <int> selected-count <=> organize.selected-count;
    in property <length> content-height <=> organize.content-height;
    in-out property <length> viewport-y <=> organize.viewport-y;
    in property <bool> dragging <=> organize.dragging;
    in property <int> drag-count <=> organize.drag-count;
    in property <bool> drop-line-visible <=> organize.drop-line-visible;
    in property <length> drop-line-x <=> organize.drop-line-x;
    in property <length> drop-line-y <=> organize.drop-line-y;
    in property <length> ghost-x <=> organize.ghost-x;
    in property <length> ghost-y <=> organize.ghost-y;
    in property <bool> file-hover <=> organize.file-hover;
    in property <string> status <=> organize.status;
    in property <int> focus-delegate <=> organize.focus-delegate;
    out property <length> view-width: organize.view-width;
    out property <length> view-height: organize.view-height;
    out property <length> grid-origin-x: organize.grid-origin-x;
    out property <length> grid-origin-y: organize.grid-origin-y;

    callback language-changed(string);
    callback add-pdfs <=> organize.add-pdfs;
    callback save <=> organize.save;
    callback rotate <=> organize.rotate;
    callback delete-selected <=> organize.delete-selected;
    callback layout-changed <=> organize.layout-changed;
    callback pointer-down <=> organize.pointer-down;
    callback pointer-move <=> organize.pointer-move;
    callback pointer-up <=> organize.pointer-up;
    callback grid-key <=> organize.grid-key;

    public function focus-grid() {
        organize.focus-grid();
    }

    VerticalLayout {
        // Header: title, tabs, language.
        Rectangle {
            height: 52px;
            background: T.bg-surface;
            Rectangle { y: parent.height - 1px; height: 1px; background: T.border; }
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 16px;
                spacing: 4px;
                Text {
                    text: "PDF Converter";
                    color: T.text-primary;
                    font-size: 16px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { width: 24px; }
                Rectangle {
                    accessible-role: tab-list;
                    accessible-label: @tr("Conversion kind");
                    HorizontalLayout {
                        alignment: start;
                        TabButton { text: @tr("Images → PDF"); active: root.active-tab == 0; clicked => { root.active-tab = 0; } }
                        TabButton { text: @tr("PDF → Images"); active: root.active-tab == 1; clicked => { root.active-tab = 1; } }
                        TabButton { text: @tr("Crop"); active: root.active-tab == 2; clicked => { root.active-tab = 2; } }
                        TabButton { text: @tr("Organize"); active: root.active-tab == 3; clicked => { root.active-tab = 3; } }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 2px;
                    padding-top: 13px;
                    padding-bottom: 13px;
                    accessible-role: groupbox;
                    accessible-label: @tr("Language");
                    LangButton {
                        text: "日本語";
                        active: root.language == "ja";
                        clicked => { root.language = "ja"; root.language-changed("ja"); }
                    }
                    LangButton {
                        text: "English";
                        active: root.language == "en";
                        clicked => { root.language = "en"; root.language-changed("en"); }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            organize := OrganizeView {
                width: 100%;
                height: 100%;
                visible: root.active-tab == 3;
            }
            if root.active-tab != 3: Rectangle {
                background: T.bg-app;
                Text {
                    text: @tr("Not part of this prototype");
                    color: T.text-muted;
                    font-size: T.font-lg;
                }
            }
        }
    }
}
