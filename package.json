{
  "name": "pdf-converter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pdfium:fetch": "node scripts/fetch-pdfium.ts",
    "layout:fetch": "node scripts/fetch-layout.ts",
    "licenses:check": "cargo deny check licenses bans sources && license-checker-rseidelsohn --production --excludePrivatePackages --summary --onlyAllow \"MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;Zlib;OFL-1.1\"",
    "licenses:generate": "node scripts/generate-licenses.ts",
    "manual-test:files": "node scripts/make-manual-test-files.ts",
    "layers:check": "node scripts/check-layers.ts",
    "check": "cargo fmt --check && cargo clippy --workspace --all-targets --all-features --quiet -- -D warnings && cargo test --workspace --all-features --quiet && npm run --silent format:check && npm run --silent lint && npm run --silent typecheck && npm test --silent && npm run --silent layers:check"
  },
  "dependencies": {
    "@ibm/plex-mono": "^2.5.0",
    "@ibm/plex-sans-jp": "^3.0.0",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
